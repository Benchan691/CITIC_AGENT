# Unified MCP server
MCP_SERVER_NAME=Splunk + Zimbra MCP
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8050
LOG_LEVEL=INFO
MCP_SERVER_ROOT=

# Authenticated webserver used for subscription management.
SUBSCRIPTION_SERVER_URL=http://100.114.50.103:9100
SUBSCRIPTION_SERVER_TIMEOUT=30
SUBSCRIPTION_SERVER_USER=
SUBSCRIPTION_SERVER_PASSWORD=

# PostgreSQL stores the baseline shared Splunk/Zimbra settings and authenticated
# SOC users, sessions, and workspace ownership. Zimbra passwords are supplied
# only to the login request and are never persisted.
# Non-empty values in this file override the stored settings at server startup.
APP_POSTGRES_URI=
APP_SETTINGS_ENCRYPTION_KEY=

# Non-secret Splunk settings live in spl_config.json. Keep Splunk credentials
# in this ignored .env file, never in JSON or source control. A token takes
# precedence over basic authentication when both are supplied.
SPL_CONFIG_FILE=
SPLUNK_TOKEN=
SPLUNK_USERNAME=
SPLUNK_PASSWORD=

# Initial or deployment override values for Zimbra. Remove a value to fall back
# to the PostgreSQL setting or edit it in the DeepSeek Harness UI.
ZIMBRA_HOST=https://mail.example.com/
# TLS certificate verification is disabled by default for deployments with
# private/self-signed Zimbra certificates. Set true to enforce verification.
ZIMBRA_VERIFY_SSL=false
ZIMBRA_TIMEOUT=60
ZIMBRA_ALLOW_SEND=true
ZIMBRA_MAX_ATTACHMENT_BYTES=10000000
ZIMBRA_MAX_ATTACHMENT_TEXT_CHARS=200000

# MarkItDown converts Zimbra attachments to Markdown. LLM/OCR is opt-in and
# requires the optional `markitdown-llm` dependency group.
MARKITDOWN_LLM_ENABLED=false
MARKITDOWN_LLM_API_KEY=
MARKITDOWN_LLM_BASE_URL=
MARKITDOWN_LLM_MODEL=
MARKITDOWN_LLM_TIMEOUT=60

# Write capabilities are enabled by default; set individual flags to false to disable them.
ZIMBRA_ALLOW_FILTER_WRITE=true
ZIMBRA_ALLOW_FILTER_REDIRECT=true
ZIMBRA_ALLOW_FILTER_DISCARD=true
ZIMBRA_ALLOW_FOLDER_WRITE=true
ZIMBRA_ALLOW_MOVE=true
ZIMBRA_ALLOW_SIGNATURE_WRITE=true
