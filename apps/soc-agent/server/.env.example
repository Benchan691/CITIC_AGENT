# Zimbra and subscription MCP server
MCP_SERVER_NAME=SOC Agent MCP
MCP_SERVER_DESCRIPTION=SOC Agent tools for Zimbra and subscriptions
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8050
LOG_LEVEL=INFO
MCP_SERVER_ROOT=

# Authenticated webserver used for subscription management. HTTPS is required
# unless SUBSCRIPTION_SERVER_ALLOW_INSECURE_HTTP is explicitly enabled.
SUBSCRIPTION_SERVER_URL=https://subscription.example.com:9100
SUBSCRIPTION_SERVER_TIMEOUT=30
SUBSCRIPTION_SERVER_USER=
SUBSCRIPTION_SERVER_PASSWORD=
SUBSCRIPTION_SERVER_ALLOW_INSECURE_HTTP=false

# Required by the dedicated /admin console. Values are read by the Node host
# and are never passed to Python child processes or returned by the API.
SOC_ADMIN_EMAIL=
SOC_ADMIN_PASSWORD=

# PostgreSQL stores authenticated SOC users, sessions, and workspace ownership.
# Service configuration below is deployment configuration: keep it in this
# environment file. The admin console shows service status but never edits it.
# Bounded pools default on (four connections per store); false restores per-call connections.
APP_POSTGRES_POOL=true
# Persistent control channel for authenticated email operations. 'off' spawns
# a fresh interpreter per command.
SOC_CONTROL_CHANNEL=auto

APP_POSTGRES_URI=
APP_SETTINGS_ENCRYPTION_KEY=

# Official Splunk MCP deployment configuration. Both endpoint and bearer token
# are required for Splunk tools and the admin connection check. There is no
# legacy REST fallback. Keep credentials in this ignored .env file.
# Example endpoint: https://splunk.example.com:8000/en-US/splunkd/__raw/services/mcp
SPLUNK_MCP_ENDPOINT=
SPLUNK_TOKEN=
SPLUNK_VERIFY_SSL=true
SPLUNK_ALLOW_INSECURE_HTTP=false
SPLUNK_SANITIZE_OUTPUT=true

# Zimbra deployment configuration. These values are not editable in /admin.
ZIMBRA_HOST=https://mail.example.com/
# TLS certificate verification is enabled by default. Set false only as a
# deliberate administrator choice for a private/self-signed deployment.
ZIMBRA_VERIFY_SSL=true
# HTTPS is required by default. Set this only for a deliberate cleartext
# private-network deployment.
ZIMBRA_ALLOW_INSECURE_HTTP=false
ZIMBRA_TIMEOUT=60
ZIMBRA_ALLOW_SEND=true
ZIMBRA_MAX_ATTACHMENT_BYTES=10000000
ZIMBRA_MAX_ATTACHMENT_TEXT_CHARS=200000

# MarkItDown converts Zimbra attachments to Markdown. LLM/OCR is opt-in and
# requires the optional `markitdown-llm` dependency group.
MARKITDOWN_LLM_ENABLED=false
MARKITDOWN_LLM_API_KEY=
MARKITDOWN_LLM_BASE_URL=
MARKITDOWN_LLM_MODEL=
MARKITDOWN_LLM_TIMEOUT=60

# Write capabilities are enabled by default; set individual flags to false to disable them.
ZIMBRA_ALLOW_FILTER_WRITE=true
ZIMBRA_ALLOW_FILTER_REDIRECT=true
ZIMBRA_ALLOW_FILTER_DISCARD=true
ZIMBRA_ALLOW_FOLDER_WRITE=true
ZIMBRA_ALLOW_MOVE=true
ZIMBRA_ALLOW_SIGNATURE_WRITE=true
