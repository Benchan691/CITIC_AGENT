# Unified MCP server
MCP_SERVER_NAME=Splunk + Zimbra MCP
MCP_SERVER_DESCRIPTION=SOC Agent investigation tools for Splunk and Zimbra
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8050
LOG_LEVEL=INFO
MCP_SERVER_ROOT=

# Authenticated webserver used for subscription management. HTTPS is required
# unless SUBSCRIPTION_SERVER_ALLOW_INSECURE_HTTP is explicitly enabled.
SUBSCRIPTION_SERVER_URL=https://subscription.example.com:9100
SUBSCRIPTION_SERVER_TIMEOUT=30
SUBSCRIPTION_SERVER_USER=
SUBSCRIPTION_SERVER_PASSWORD=
SUBSCRIPTION_SERVER_ALLOW_INSECURE_HTTP=false

# Required by the dedicated /admin console. Values are read by the Node host
# and are never passed to Python child processes or returned by the API.
SOC_ADMIN_EMAIL=
SOC_ADMIN_PASSWORD=

# PostgreSQL stores authenticated SOC users, sessions, and workspace ownership.
# Service configuration below is deployment configuration: keep it in this
# environment file. The admin console shows service status but never edits it.
APP_POSTGRES_URI=
APP_SETTINGS_ENCRYPTION_KEY=

# Splunk deployment configuration. Keep credentials in this ignored .env file,
# never in source control. A token takes precedence over basic authentication
# when both are supplied.
SPLUNK_HOST=
SPLUNK_HOST_FOR_DOCKER=
RUNNING_INSIDE_DOCKER=0
SPLUNK_URL=
SPLUNK_PORT=8089
SPLUNK_SCHEME=https
SPLUNK_VERIFY_SSL=true
SPLUNK_TOKEN=
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
SPLUNK_ALLOW_INSECURE_HTTP=false
SPLUNK_REQUEST_TIMEOUT=30
SPLUNK_JOB_TIMEOUT=120
SPLUNK_MAX_EVENTS=1000
SPLUNK_RISK_TOLERANCE=75
SPLUNK_SAFE_TIMERANGE=24h
SPLUNK_SANITIZE_OUTPUT=true
SPLUNK_ALLOW_DETECTION_WRITE=false
SPLUNK_ALLOW_DETECTION_ENABLE=false
SPLUNK_DETECTION_APP=search
SPLUNK_DETECTION_OWNER=nobody
SPLUNK_DETECTION_APPROVAL_TTL_SECONDS=600
SPLUNK_SEARCH_PLANNER_MAX_REFINEMENTS=2

# Search policy and resource limits. Keep these deployment-owned; the admin
# console reports service status only and does not expose these values.
SPLUNK_POLICY_SHORT_SEARCH_SECONDS=86400
SPLUNK_POLICY_NORMAL_SEARCH_SECONDS=604800
SPLUNK_POLICY_VERY_LONG_SEARCH_SECONDS=2592000
SPLUNK_POLICY_WILDCARD_INDEX=require_approval
SPLUNK_POLICY_NO_INDEX=require_approval
SPLUNK_POLICY_LONG_RAW=require_approval
SPLUNK_POLICY_VERY_LONG=require_approval
SPLUNK_POLICY_ALL_TIME=require_approval
SPLUNK_POLICY_EXPENSIVE_COMMAND=require_approval
SPLUNK_POLICY_SUBSEARCH=require_approval
SPLUNK_POLICY_NESTED_SUBSEARCH=require_approval
SPLUNK_POLICY_UNRESOLVED_MACRO=require_approval
SPLUNK_POLICY_UNPARSEABLE_TIME=require_approval
SPLUNK_POLICY_MAX_SUBSEARCH_DEPTH=1
SPLUNK_POLICY_TRUSTED_MACROS=
SPLUNK_SEARCH_GLOBAL_CONCURRENCY=8
SPLUNK_SEARCH_PER_PRINCIPAL_CONCURRENCY=2
SPLUNK_SEARCH_QUEUE_TIMEOUT_SECONDS=5
SPLUNK_SEARCH_MAX_JOBS_PER_MINUTE=20
SPLUNK_SEARCH_BUDGET_PER_MINUTE=20
SPLUNK_SEARCH_MAX_RUNTIME_LOW=30
SPLUNK_SEARCH_MAX_RUNTIME_MEDIUM=60
SPLUNK_SEARCH_MAX_RUNTIME_HIGH=120
SPLUNK_SEARCH_MAX_LOOKBACK_LOW=86400
SPLUNK_SEARCH_MAX_LOOKBACK_MEDIUM=604800
SPLUNK_SEARCH_MAX_LOOKBACK_HIGH=2592000
SPLUNK_SEARCH_MAX_RESULTS_LOW=100
SPLUNK_SEARCH_MAX_RESULTS_MEDIUM=500
SPLUNK_SEARCH_MAX_RESULTS_HIGH=1000
SPLUNK_SEARCH_BACKTEST_CONCURRENCY=1
SPLUNK_SEARCH_RESTRICTED_DECISION=deny
SECURITY_QUEUE_MAX_BACKEND_PAGES_PER_REQUEST=10
SECURITY_QUEUE_MAX_BACKEND_RECORDS_PER_REQUEST=1000
SECURITY_QUEUE_STANDARD_CONCURRENCY=5

# Zimbra deployment configuration. These values are not editable in /admin.
ZIMBRA_HOST=https://mail.example.com/
# TLS certificate verification is enabled by default. Set false only as a
# deliberate administrator choice for a private/self-signed deployment.
ZIMBRA_VERIFY_SSL=true
# HTTPS is required by default. Set this only for a deliberate cleartext
# private-network deployment.
ZIMBRA_ALLOW_INSECURE_HTTP=false
ZIMBRA_TIMEOUT=60
ZIMBRA_ALLOW_SEND=true
ZIMBRA_MAX_ATTACHMENT_BYTES=10000000
ZIMBRA_MAX_ATTACHMENT_TEXT_CHARS=200000

# MarkItDown converts Zimbra attachments to Markdown. LLM/OCR is opt-in and
# requires the optional `markitdown-llm` dependency group.
MARKITDOWN_LLM_ENABLED=false
MARKITDOWN_LLM_API_KEY=
MARKITDOWN_LLM_BASE_URL=
MARKITDOWN_LLM_MODEL=
MARKITDOWN_LLM_TIMEOUT=60

# Write capabilities are enabled by default; set individual flags to false to disable them.
ZIMBRA_ALLOW_FILTER_WRITE=true
ZIMBRA_ALLOW_FILTER_REDIRECT=true
ZIMBRA_ALLOW_FILTER_DISCARD=true
ZIMBRA_ALLOW_FOLDER_WRITE=true
ZIMBRA_ALLOW_MOVE=true
ZIMBRA_ALLOW_SIGNATURE_WRITE=true
