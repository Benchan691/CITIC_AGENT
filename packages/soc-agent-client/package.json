{
  "name": "dsh-soc-agent-client",
  "private": true,
  "version": "0.1.0",
  "description": "Mandatory SOC Agent browser runtime, authentication gate, and policy contract.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dsh": {
    "client": {
      "inject": [
        "dsh-soc-agent-connection",
        "dsh-soc-agent-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "dsh-soc-agent-connection": "0.1.0",
    "dsh-soc-agent-ui-layout": "0.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "dsh-soc-agent-connection": "workspace:^",
    "dsh-soc-agent-ui-layout": "workspace:^",
    "react": "^18.2.0",
    "typescript": "^5.9.2"
  }
}
