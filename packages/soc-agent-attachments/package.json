{
  "name": "dsh-soc-agent-attachments",
  "private": true,
  "version": "0.1.0",
  "description": "Optional MarkItDown document attachment and settings feature.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "dsh-soc-agent-client",
        "dsh-soc-agent-connection",
        "dsh-soc-agent-ui-chat",
        "dsh-soc-agent-ui-commands",
        "dsh-soc-agent-ui-conversation",
        "dsh-soc-agent-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-trajectory"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-trajectory": "0.1.5-rc.2",
    "dsh-soc-agent-ui-chat": "0.1.0",
    "dsh-soc-agent-ui-renderer": "0.1.0",
    "dsh-soc-agent-client": "0.1.0",
    "dsh-soc-agent-connection": "0.1.0",
    "dsh-soc-agent-ui-commands": "0.1.0",
    "dsh-soc-agent-ui-conversation": "0.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-trajectory": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "dsh-soc-agent-client": "workspace:^",
    "dsh-soc-agent-connection": "workspace:^",
    "dsh-soc-agent-ui-commands": "workspace:^",
    "dsh-soc-agent-ui-conversation": "workspace:^",
    "dsh-soc-agent-ui-chat": "workspace:^",
    "dsh-soc-agent-ui-renderer": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts"
  ]
}
