{
  "name": "dsh-soc-agent-session-log-export",
  "description": "Web Session-log export command and shared download dialog",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session-query/session-log-export"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run tests"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-format": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.2",
    "@types/react": "~18.3.1",
    "dsh-soc-agent-agent": "workspace:^",
    "dsh-soc-agent-connection": "workspace:^",
    "dsh-soc-agent-ui-commands": "workspace:^",
    "dsh-soc-agent-ui-conversation": "workspace:^",
    "dsh-soc-agent-ui-renderer": "workspace:^",
    "dsh-soc-agent-ui-session": "workspace:^",
    "react": "^18.2.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "dsh-soc-agent-ui-commands",
        "dsh-soc-agent-ui-conversation",
        "dsh-soc-agent-ui-renderer",
        "dsh-soc-agent-ui-session"
      ],
      "platform": "web"
    }
  }
}
