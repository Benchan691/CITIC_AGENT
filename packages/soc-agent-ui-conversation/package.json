{
  "name": "dsh-soc-agent-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "dsh-soc-agent-session-controller",
        "dsh-soc-agent-file-upload",
        "@deepseek-ai/dsh-client-locale",
        "dsh-soc-agent-ui-layout",
        "dsh-soc-agent-ui-renderer",
        "dsh-soc-agent-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "dsh-soc-agent-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-goal": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.5-rc.2",
    "@lexical/headless": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "dsh-soc-agent-api-remotes": "workspace:^",
    "dsh-soc-agent-file-upload": "workspace:^",
    "dsh-soc-agent-session-controller": "workspace:^",
    "dsh-soc-agent-ui-layout": "workspace:^",
    "dsh-soc-agent-ui-renderer": "workspace:^",
    "dsh-soc-agent-ui-session": "workspace:^",
    "dsh-soc-agent-workspace": "workspace:^",
    "dsh-soc-agent-workspace-controller": "workspace:^",
    "lexical": "^0.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
