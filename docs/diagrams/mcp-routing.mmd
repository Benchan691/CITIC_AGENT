%% MCP routing — names, allowlists, policy, model/UI path (verified against b26d55d)
flowchart LR
    model["Model"]
    gate{"host.js tools/pre-execute<br/>exact name ∈ DOMAIN_TOOLS ∪ CONTROL_TOOLS?"}
    mode{"mode / per-tool state"}
    deny["deny"]
    ask["ask → approval waterfall (fail-closed)"]
    run["delegate"]

    subgraph servers["MCP servers"]
        soca["soc_agent (local stdio)<br/>27 tools: zimbra_* + subscriptions"]
        splk["splunk_mcp (bridge → external)<br/>13 read tools"]
    end
    ui2["ui__soc_agent__send_email<br/>(UI-confirmed catalog entry — NOT a tool)"]
    skilltool["skill (host tool, unprefixed)"]
    proj["investigation.js projection<br/>mask PII · truncate 50KB (splunk_mcp only)"]
    ext["External official Splunk MCP"]

    raw1["cordis.patch.yml raw allowlist (27)"] --> soca
    raw2["OFFICIAL_SPLUNK_TOOL_NAMES (13)"] --> splk
    soca --> gate
    splk --> gate
    skilltool --> gate
    gate -->|no| deny
    gate -->|yes| mode
    mode -->|disabled / soc| deny
    mode -->|ask| ask
    mode -->|auto or full| run
    run --> soca
    run --> splk --> proj --> model
    soca --> model
    ui2 -.->|"human click → send-email RPC"| soca
