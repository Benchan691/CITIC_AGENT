# Unified MCP server
MCP_SERVER_NAME=Splunk + Zimbra MCP
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8050
LOG_LEVEL=INFO

# PostgreSQL-backed UI settings. unified-dev derives the Docker-facing URI
# automatically, so localhost works for the host MCP process.
APP_POSTGRES_URI=
# Use a shared secret in every MCP/Agent process. Plaintext values are never stored in PostgreSQL.
APP_SETTINGS_ENCRYPTION_KEY=

# Splunk: token auth is preferred; otherwise set username and password.
SPLUNK_HOST=splunk.example.com
SPLUNK_PORT=8089
SPLUNK_SCHEME=https
SPLUNK_URL=
SPLUNK_TOKEN=
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
SPLUNK_VERIFY_SSL=true
SPLUNK_REQUEST_TIMEOUT=30
SPLUNK_JOB_TIMEOUT=120
SPLUNK_MAX_EVENTS=1000
SPLUNK_RISK_TOLERANCE=75
SPLUNK_SAFE_TIMERANGE=24h
SPLUNK_SANITIZE_OUTPUT=true
# Detection writes are disabled by default. Draft persistence requires the first flag;
# enabling a reviewed rule additionally requires the second flag.
SPLUNK_ALLOW_DETECTION_WRITE=false
SPLUNK_ALLOW_DETECTION_ENABLE=false
SPLUNK_DETECTION_APP=search
SPLUNK_DETECTION_OWNER=nobody

# Zimbra shared server settings. Add mailbox credentials from the frontend.
ZIMBRA_HOST=mail.example.com
ZIMBRA_VERIFY_SSL=true
ZIMBRA_TIMEOUT=60
ZIMBRA_ACCOUNTS_FILE=.data/zimbra_accounts.enc
ZIMBRA_ACCOUNTS_KEY_FILE=.data/zimbra_accounts.key
# Optional: derive the encryption key from this value instead of the key file.
ZIMBRA_ACCOUNTS_KEY=
# Required for account management when the server is accessed remotely.
ZIMBRA_ACCOUNT_API_KEY=
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Write capability is off by default. Enable only when needed.
ZIMBRA_ALLOW_SEND=false

# Deep Agent. Provider credentials (for example OPENAI_API_KEY) are also read from the environment.
# The UI model selector sends only `deepseek` or `local`; all endpoints and credentials stay here.
DEEP_AGENT_DEFAULT_PROVIDER=deepseek
# To switch to DeepSeek, replace the DEEP_AGENT_MODEL line above with these settings
# (keep only one DEEP_AGENT_MODEL entry):
# DEEP_AGENT_PROVIDER=deepseek
# DEEP_AGENT_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local llama.cpp OpenAI-compatible server (the local option in the UI).
LOCAL_MODEL_BASE_URL=http://127.0.0.1:6767/v1
LOCAL_MODEL_NAME=/models/Qwen_Qwen3.6-35B-A3B-IQ4_XS.gguf
LOCAL_MODEL_CONTEXT_TOKENS=8192
LOCAL_MODEL_API_KEY=local
# The frontend and agent use the same HTTP MCP server so the account API is reachable.
MCP_SERVER_URL=http://127.0.0.1:8050/mcp

# LangGraph persistence. Set LANGGRAPH_POSTGRES_URI to override the shared
# APP_POSTGRES_URI fallback. unified-dev rewrites local loopback hosts for Docker.
LANGGRAPH_POSTGRES_URI=
# Use true when deliberately refreshing the LangGraph API image; local startup
# defaults to the image already present on this machine.
LANGGRAPH_PULL=false
# First-time Docker image pulls/builds can take several minutes.
LANGGRAPH_STARTUP_TIMEOUT_SECONDS=600
